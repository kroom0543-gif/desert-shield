{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Represents a potential client inquiry or quote request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "serviceType": { "type": "string" },
        "numberOfGuards": { "type": "string" },
        "budgetRange": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "contacted", "qualified", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "contactPerson", "email", "phone", "serviceType", "status", "createdAt"]
    }
  },
  "firestore": {
    "leads/{leadId}": {
      "schema": "Lead",
      "description": "Information about potential client leads."
    }
  }
}
